# ------------------------------------------------------------
#  Nino D — environment variables
#  Copy to .env.local (local) or add in your host's dashboard.
# ------------------------------------------------------------

# Google Analytics 4 (optional — this ID is already the default in code)
NEXT_PUBLIC_GA_ID=G-PSS9WZ9ZL0

# ---- Inquiry delivery: set up at least ONE of the two ----

# 1) Telegram — instant notification on your phone (recommended for the fair)
#    • In Telegram, message @BotFather → /newbot → copy the token
#    • Send any message to your new bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates  and copy "chat":{"id": ...}
#    • For a group: add the bot to the group, send a message there, use the (negative) group id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Email via Resend (resend.com) — requires verifying the ninod.space domain there
RESEND_API_KEY=
INQUIRY_TO_EMAIL=studio@ninod.space
INQUIRY_FROM_EMAIL=Nino D Website <inquiries@ninod.space>

# If neither is configured, visitors still reach you: the form switches to
# prefilled WhatsApp / email buttons. A backup copy is written to data/inquiries.jsonl
# when the server's filesystem allows it.
